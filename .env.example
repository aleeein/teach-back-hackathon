# Copy this file to .env and fill it in. Never commit .env: it holds your key.

# Which AI Byte uses: anthropic (Claude API, needs a key and credit)
# or ollama (a free model running on your own computer).
AI_PROVIDER=anthropic

# --- Option A: Claude API ---
# Create a key at https://console.anthropic.com (Settings > API keys).
ANTHROPIC_API_KEY=
# Haiku is fast and cheap for testing. Swap for a larger model for the demo if you like.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Option B: Ollama (local, private, free) ---
# Install from https://ollama.com, then run: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# How much text the model reads at once. 8192 suits most laptops; raise it for big uploads.
OLLAMA_NUM_CTX=8192
# Keep the model loaded between requests so replies stay fast.
OLLAMA_KEEP_ALIVE=30m

# --- Server ---
PORT=3000
# How long to wait for one AI reply, in milliseconds. Course building is the slowest step.
AI_TIMEOUT_MS=120000
# On a laptop without a strong GPU, Ollama can be slow: try AI_TIMEOUT_MS=300000
